generator client {
  provider = "prisma-client-js"
}

// Supports both SQLite (local dev) and PostgreSQL (production/Vercel)
// Set DATABASE_PROVIDER=postgresql for production, default is sqlite
datasource db {
  provider = "sqlite"
}

model User {
  id              String   @id @default(cuid())
  username        String   @unique
  password        String
  name            String
  role            String   @default("admin")
  isActive        Boolean  @default(true)
  linkedDoctorId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  doctor          Doctor?
}

model Specialty {
  id            String   @id @default(cuid())
  name          String
  nameAr        String
  description   String?
  descriptionAr String?
  isActive      Boolean  @default(true)
  config        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  doctors       Doctor[]
}

model Doctor {
  id                String    @id @default(cuid())
  name              String
  nameAr            String
  email             String?   @unique
  phone             String?
  specialtyId       String
  specialty         Specialty @relation(fields: [specialtyId], references: [id])
  licenseNumber     String?
  qualification     String?
  qualificationAr   String?
  experienceYears   Int?
  consultationFee   Float?
  workingDays       String?
  workingHoursStart String?
  workingHoursEnd   String?
  bio               String?
  bioAr             String?
  logoUrl           String?
  clinicLat         Float?
  clinicLng         Float?
  clinicAddress     String?
  isActive          Boolean   @default(true)
  userId            String?   @unique
  user              User?     @relation(fields: [userId], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  appointments      Appointment[]
  patients          Patient[]
}

model Patient {
  id                String    @id @default(cuid())
  patientNumber     String    @unique
  name              String
  nameAr            String?
  dateOfBirth       DateTime?
  gender            String
  phone             String
  email             String?
  address           String?
  nationalId        String?
  bloodType         String?
  insurance         String?
  medicalHistory    String?
  allergies         String?
  emergencyContact  String?
  emergencyPhone    String?
  doctorId          String?
  doctor            Doctor?   @relation(fields: [doctorId], references: [id])
  isActive          Boolean   @default(true)
  isRecurring       Boolean   @default(false)
  treatmentType     String?
  totalSessions     Int?
  sessionsCompleted Int?      @default(0)
  nextVisitDate     DateTime?
  recurringWeeks    Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  appointments      Appointment[]
}

model Appointment {
  id                String   @id @default(cuid())
  appointmentNumber String   @unique
  patientId         String
  patient           Patient  @relation(fields: [patientId], references: [id])
  doctorId          String
  doctor            Doctor   @relation(fields: [doctorId], references: [id])
  date              DateTime
  duration          Int      @default(30)
  type              String   @default("consultation")
  status            String   @default("scheduled")
  arrivalStatus     String   @default("pending")
  queueNumber       Int?
  isPaid            Boolean  @default(false)
  reason            String?
  notes             String?
  diagnosis         String?
  prescription      String?
  completedAt       DateTime?
  holdReason        String?
  returnedFromTest  Boolean  @default(false)
  editedBy          String?  // "secretary" or "doctor" userId
  editNote          String?  // note about who made the edit
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Message {
  id          String   @id @default(cuid())
  fromUserId  String
  toUserId    String
  content     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model DoctorSubscription {
  id          String   @id @default(cuid())
  doctorId    String   @unique
  expiresAt   DateTime
  notified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
