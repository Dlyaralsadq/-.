{
  "name": "iraq-clinic-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:clinic": "npm run dev -w @iraq-clinic/clinic-system",
    "dev:patient": "npm run dev -w @iraq-clinic/patient-web",
    "build:clinic": "npm run build -w @iraq-clinic/clinic-system",
    "build:patient": "npm run build -w @iraq-clinic/patient-web",
    "build": "npm run db:generate && npm run build:clinic && npm run build:patient",
    "lint": "npm run lint -w @iraq-clinic/clinic-system && npm run lint -w @iraq-clinic/patient-web",
    "db:generate": "npm run db:generate -w @iraq-clinic/database",
    "db:migrate": "npm run db:migrate -w @iraq-clinic/database",
    "db:seed": "npm run db:seed -w @iraq-clinic/database",
    "db:studio": "npm run db:studio -w @iraq-clinic/database",
    "db:reset": "npm run db:reset -w @iraq-clinic/database"
  }
}
